# Copy to .env and edit as needed.

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
PA_CHAT_MODEL=qwen2.5:32b-instruct-q4_K_M
PA_EMBED_MODEL=nomic-embed-text

# Vault — the mount point of the encrypted sparsebundle
PA_VAULT_PATH=/Volumes/PA-Vault

# Require the vault path to be a real macOS mount point. Set to false to run
# against a plain directory (used by `make dev` for the unencrypted dev vault).
# Don't disable in production — it's what stops the app from operating on an
# empty /Volumes/PA-Vault when the sparsebundle isn't attached.
PA_VAULT_REQUIRE_MOUNT=true

# Sparsebundle source file (used by scripts/vault-mount.sh)
PA_VAULT_SPARSEBUNDLE=~/Library/PersonalAssistant/PA-Vault.sparsebundle

# 1Password CLI reference for the vault passphrase.
# Leave empty to use hdiutil's interactive GUI prompt instead.
# When set, scripts/vault-mount.sh pipes `op read "$PA_VAULT_OP_REF"` into hdiutil,
# which lets 1Password show its native unlock prompt (biometric / system auth)
# rather than typing the passphrase by hand each session.
PA_VAULT_OP_REF=op://<your-vault>/PA-Vault/password

# Web server
PA_HOST=127.0.0.1
PA_PORT=8765

# Agent
PA_MAX_TOOL_ITERATIONS=8
PA_HISTORY_TURNS=20

# Logging
PA_LOG_LEVEL=INFO
